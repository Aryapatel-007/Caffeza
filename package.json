{
  "name": "restaurant-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant restaurant ERP. Root workspace.",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "start": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "lint": "eslint .",
    "provision:restaurant": "npm run provision:restaurant --workspace=server",
    "seed:demo": "npm run seed:demo --workspace=server",
    "seed:golden": "npm run seed:golden --workspace=server",
    "db:indexes": "npm run db:indexes --workspace=server",
    "setup:restaurant": "npm run setup:restaurant --workspace=server --",
    "import:menu": "npm run import:menu --workspace=server --",
    "smoke": "npm run smoke --workspace=server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0"
  }
}
