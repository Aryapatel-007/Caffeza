# Copy this file to .env and fill in real values.
# .env is in .gitignore. Never commit it.
# If you add a variable here, tell the other developer in the same commit.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Local: mongodb://127.0.0.1:27017/restaurant-erp
# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/restaurant-erp
MONGO_URI=mongodb://127.0.0.1:27017/restaurant-erp

# --- Auth ---
# Generate with: openssl rand -base64 48
# These two must be different values.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string

# How long a login lasts.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Cost factor for password hashing. 12 is a sane default.
BCRYPT_ROUNDS=12

# --- Client ---
# Where the React app runs. Used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# --- Rate limiting ---
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# --- Display ---
# Stored time is always UTC. This is only used for formatting output.
DISPLAY_TIMEZONE=Asia/Kolkata

# --- Demo seed script ---
# Read directly by scripts/seedDemo.js, not by config/env.js: this is not
# something the running server needs, only something the seed script's own
# safety check consults. Comma-separated MONGO_URI hostnames the script is
# allowed to write demo data into when that URI is not localhost. Empty by
# default, so writing demo data anywhere but localhost is an explicit,
# deliberate opt-in, never an accident. Only ever name a shared development
# cluster here, never a production one.
SEED_DEMO_ALLOWED_HOSTS=

# Password for the demo seed accounts. Required by seedDemo.js; there is no default.
DEMO_PASSWORD=change-me
